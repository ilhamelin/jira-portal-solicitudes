# Entorno de variables de ejemplo (copiar a .env)

# Jira Cloud
JIRA_INSTANCE_URL="https://tu-organizacion.atlassian.net"
JIRA_USER_EMAIL="tu-email@dominio.com"
JIRA_API_TOKEN="tu-api-token-secreto"
JIRA_PROJECT_KEY="SOL"

# Supabase (PostgreSQL)
SUPABASE_URL="https://tu-ref-id.supabase.co"
SUPABASE_ANON_KEY="tu-anon-key"
SUPABASE_SERVICE_ROLE_KEY="tu-service-role-key"
DATABASE_URL="postgresql://postgres.[ref-id]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres"

# Backend & App Config
PORT=8000
ENVIRONMENT="development"
JWT_SECRET_KEY="tu-clave-secreta-jwt-aqui"
ALLOWED_ORIGINS="http://localhost:5173,https://tu-portal.vercel.app"
